# Este repositorio publica solamente el libro. El resto de esta carpeta es
# material histórico o de trabajo y permanece fuera de Git.
/*

!/.gitignore
!/README.md
!/_config.yml
!/_toc.yml
!/index.md
!/requirements.txt
!/UPlogo.png

!/.github/
/.github/*
!/.github/workflows/
!/.github/workflows/deploy-pages.yml

!/unidad_1/
/unidad_1/*
!/unidad_1/index.md
!/unidad_1/01_vectores_geometria_matrices.md
!/unidad_1/01_laboratorio_vectores_matrices.ipynb
!/unidad_1/01_repaso_trigonometria.ipynb
!/unidad_1/02_eliminacion_gauss_jordan.md
!/unidad_1/02_laboratorio_gauss_jordan.ipynb
!/unidad_1/03_combinacion_independencia.md
!/unidad_1/04_subespacios_bases_dimension.md
!/unidad_1/04_laboratorio_subespacios_nucleo_imagen.ipynb
!/unidad_1/05_nucleo_imagen_rango.md
!/unidad_1/06_determinante_invertibilidad.md
!/unidad_1/06_laboratorio_determinante.ipynb
!/unidad_1/07_espacios_vectoriales_afines_suma_directa.md
!/unidad_1/07_laboratorio_espacios_suma_directa.ipynb
!/unidad_1/08_coordenadas_cambio_base.md
!/unidad_1/08_laboratorio_cambio_base.ipynb
!/unidad_1/09_repaso_teorico_pc1.md
!/unidad_1/09_preparacion_pc1.md
!/unidad_1/09_laboratorio_preparacion_pc1.ipynb

!/unidad_2/
/unidad_2/*
!/unidad_2/index.md
!/unidad_2/01_ortogonalidad_gram_schmidt.md
!/unidad_2/01_laboratorio_gram_schmidt.ipynb
!/unidad_2/02_distancia_proyeccion_hiperplanos.md
!/unidad_2/02_laboratorio_proyecciones.ipynb
!/unidad_2/figuras/
/unidad_2/figuras/*
!/unidad_2/figuras/proyeccion_convexa.svg
!/unidad_2/figuras/proyeccion_subespacio.svg
!/unidad_2/figuras/proyeccion_hiperplano.svg

# Salidas locales del libro y entornos virtuales.
/_build/
/.jupyter_cache/
/.venv/
